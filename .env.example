# Copy to .env.local and fill in. Never commit the filled-in copy.
# (.gitignore keeps .env* out but deliberately allows THIS file through.)

# --- Required ---

# Postgres connection string. A free Neon database works. The deploy button does
# NOT provision one — you add it from the Vercel dashboard afterwards, and Vercel
# then sets this for you. See docs/SETUP.md, step 2b.
#
# TLS is required, so a plain local Postgres without SSL will not connect.
DATABASE_URL=

# Password for the dashboard itself. REQUIRED in production: with it unset,
# Pawline refuses to serve any page rather than showing your pet's data to
# anyone with the URL. Locally (`npm run dev`) it may be left blank.
# Use something long and random.
APP_PASSWORD=

# 32 random bytes, base64. Encrypts any account credentials stored in the
# database. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing or changing this does not lose your health data — only the stored
# credentials, which you re-enter in Setup.
ENCRYPTION_KEY=

# Shared secret protecting the scheduled collection endpoint. Any long random
# string. If this is unset, the endpoint refuses to run in production rather
# than running unauthenticated.
CRON_SECRET=

# --- Optional ---

# Email alerts. Without these the app still records everything and shows
# alerts on the dashboard; it just won't email you.
#
# NOTE: Resend's shared onboarding@resend.dev sender can only deliver to the
# email address that owns the Resend account. To send anywhere else you must
# verify your own domain and set ALERT_FROM to an address at that domain.
RESEND_API_KEY=
ALERT_EMAIL=
# ALERT_FROM="Pawline <alerts@yourdomain.com>"

# Gmail is the simpler route for emailing yourself, and is normally entered on
# the Setup page rather than here. These exist so a self-hosted deployment can
# configure it without a browser. Use a Google App Password, never your account
# password — and note that Google describes an App Password as granting access
# to the Google account, so create one solely for this.
# GMAIL_USER=you@gmail.com
# GMAIL_APP_PASSWORD=

# Identifies this client to Tractive. It has a working default, so you only need
# this if that default stops being accepted. Relevant only if you enable the
# Tractive source, which is off unless you explicitly turn it on.
# TRACTIVE_CLIENT_ID=
